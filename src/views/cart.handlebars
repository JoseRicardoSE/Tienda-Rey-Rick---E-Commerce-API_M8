<div class="row">
  <div class="col-md-8 mx-auto">
    <div class="card">
      <div class="card-header bg-white">
        <h2 class="h5 mb-0">Mi Carrito</h2>
      </div>
      <div class="card-body">
        <div id="auth-warning" class="alert alert-warning d-none">
          Debes iniciar sesión para ver tu carrito.
        </div>
        <ul id="lista-carrito" class="list-group mb-3">
          <!-- Renderizado por JS -->
        </ul>
        <div class="d-flex justify-content-between align-items-center">
          <p class="mb-0 fs-5">Total: <strong id="total-carrito">$0</strong></p>
          <button id="btn-comprar" type="button" class="btn btn-primary" disabled>Comprar</button>
        </div>
      </div>
    </div>
  </div>
</div>
