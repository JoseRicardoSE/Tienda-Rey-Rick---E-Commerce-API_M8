<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Tienda Rey Rick</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/custom.css">
</head>
<body>

  <header class="container-fluid sticky-top bg-white border-bottom mb-4">
    <div class="container py-3">
      <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div>
          <h1 class="h3 mb-0"><a href="/" class="text-decoration-none text-dark">Tienda Rey Rick</a></h1>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <div id="auth-section">
            <!-- Renderizado dinámicamente vía JS -->
          </div>
          <a href="/cart" class="btn btn-outline-primary">
            Carrito (<span id="contador-carrito-global">0</span>)
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="container mb-4" style="min-height: 70vh;">
    {{{body}}}
  </main>

  <div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
      <div id="toast-mensaje" class="toast-body"></div>
    </div>
  </div>

  <footer>
    <div class="container text-center text-muted small">
        <p class="mb-0">© 2024 Tienda Rey Rick - Todos los derechos reservados.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/script.js"></script>
</body>
</html>
